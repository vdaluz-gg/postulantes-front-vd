/*
 * Chequeo de tipos y tests del portal separado. rootDirs une portal-postulantes/src con ../src:
 * los imports relativos que apuntan a dependencias compartidas (ícono, sonidos, tema, almacenamiento,
 * movimiento) se resuelven en la app principal sin copiarlas.
 */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "CommonJS",
    "isolatedModules": true,
    "rootDirs": ["./src", "../src"],
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "../setup-jest.ts"]
}
